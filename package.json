{
  "name": "wirdwatcher",
  "productName": "wirdwatcher",
  "version": "2.0.0",
  "description": "Rate random words out of 5.0, alone, with friends, or around a table of up to 8. Peer-to-peer, no server, no account.",
  "author": "Harviel Arcilla",
  "license": "MIT",
  "type": "module",
  "main": "src/main/main.js",
  "scripts": {
    "start": "node build.mjs && electron .",
    "dev": "node build.mjs && electron .",
    "build": "node build.mjs",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "words": "node scripts/build-words.mjs",
    "dist": "node build.mjs && electron-builder",
    "dist:mac": "node build.mjs && electron-builder --mac",
    "dist:win": "node build.mjs && electron-builder --win"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/HarvielArcilla/wirdwatcher.git"
  },
  "dependencies": {
    "@hyperswarm/secret-stream": "^6.9.2",
    "b4a": "^1.9.0",
    "hypercore-crypto": "^3.7.0",
    "hyperswarm": "^4.17.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "hyperdht": "^6.34.1",
    "playwright-core": "^1.56.0"
  },
  "build": {
    "appId": "com.harvielarcilla.wirdwatcher",
    "productName": "wirdwatcher",
    "directories": {
      "output": "release"
    },
    "files": [
      "build/icon.png",
      "src/**",
      "renderer/index.html",
      "renderer/styles.css",
      "renderer/dist/app.js",
      "assets/**",
      "data/**",
      "package.json",
      "!src/renderer/**"
    ],
    "asarUnpack": [
      "**/*.node",
      "**/prebuilds/**"
    ],
    "npmRebuild": false,
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.word-games",
      "identity": null
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Game",
      "executableName": "wirdwatcher"
    }
  }
}
