{
  "name": "wirdwatcher",
  "productName": "wirdwatcher",
  "version": "2.3.0",
  "description": "Rate random words out of 5.0, alone, with friends, or around a table of up to 8. Peer-to-peer, no server, no account.",
  "author": "Harviel Arcilla",
  "license": "MIT",
  "type": "module",
  "main": "src/main/main.js",
  "scripts": {
    "start": "node build.mjs && electron .",
    "dev": "node build.mjs && electron .",
    "dev:account": "node build.mjs && electron . --dev",
    "build": "node build.mjs",
    "test": "node --test --test-concurrency=1 --test-timeout=180000 \"test/*.test.js\"",
    "smoke": "node build.mjs && electron . --smoke-test",
    "words": "node scripts/build-words.mjs",
    "dist": "node build.mjs && electron-builder",
    "dist:mac": "node build.mjs && electron-builder --mac",
    "dist:win": "node build.mjs && electron-builder --win",
    "postinstall": "node scripts/brand.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/HarvielArcilla/wirdwatcher-friends.git"
  },
  "dependencies": {
    "@hyperswarm/secret-stream": "^6.9.2",
    "b4a": "^1.9.0",
    "electron-updater": "6.8.10",
    "hypercore-crypto": "^3.7.0",
    "hyperswarm": "^4.17.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "hyperdht": "^6.34.1",
    "playwright-core": "^1.56.0",
    "rcedit": "^5.0.2"
  },
  "build": {
    "appId": "com.harvielarcilla.wirdwatcher",
    "productName": "wirdwatcher",
    "directories": {
      "output": "release"
    },
    "files": [
      "build/icon.png",
      "build/icon.ico",
      "src/**",
      "renderer/index.html",
      "renderer/styles.css",
      "renderer/dist/app.js",
      "assets/**",
      "data/**",
      "package.json",
      "!src/renderer/**"
    ],
    "asarUnpack": [
      "**/*.node",
      "**/prebuilds/**"
    ],
    "npmRebuild": false,
    "publish": [
      {
        "provider": "github",
        "owner": "HarvielArcilla",
        "repo": "wirdwatcher-friends",
        "releaseType": "release"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.word-games",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "icon": "build/icon.png",
      "artifactName": "wirdwatcher-${version}-${arch}.${ext}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "wirdwatcher-setup-${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Game",
      "executableName": "wirdwatcher"
    }
  }
}
